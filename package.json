{
  "name": "usejunior",
  "version": "1.0.6",
  "type": "module",
  "description": "Ranked work inbox for engineers — every item arrives with its action drafted, dispatch straight into your local Claude Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usejunior-sh/junior.git"
  },
  "homepage": "https://usejunior.sh",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "junior": "dist/server/cli.js",
    "junior-mcp": "dist/server/mcp.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "PORT=5188 node scripts/dev.mjs",
    "dev:copy-prod": "node scripts/copy-prod.mjs",
    "clear-port": "./clear-port.sh",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:serve": "tsx scripts/demo/run.ts serve",
    "demo:shots": "tsx scripts/demo/run.ts shots",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:server": "PORT=5188 tsx --import ./scripts/dev-home.mjs server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "dev:web": "vite",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.publish.json",
    "start": "tsx server/index.ts",
    "prod:snapshot": "node scripts/prod-snapshot.mjs",
    "app:snapshot": "node scripts/app-snapshot.mjs",
    "release": "node scripts/release.mjs",
    "prod:local": "npm run build && npm pack && npm i -g ./usejunior-$npm_package_version.tgz && rm -f ./usejunior-$npm_package_version.tgz",
    "app:build": "npm --prefix desktop run build --",
    "dev:app": "npm --prefix desktop install && JUNIOR_APP_PORT=5188 JUNIOR_APP_URL=http://localhost:5189 npm --prefix desktop start",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.4.1",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cronstrue": "^3.31.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.37.0",
    "marked": "^18.0.11",
    "mermaid": "^12.0.0",
    "playwright-core": "^1.64.1",
    "qrcode-generator": "^1.5.2",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
