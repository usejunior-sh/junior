{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@assets/*": ["./assets/*"]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "web/src",
    "shared",
    "core/work/types.ts",
    "core/teams/recipe.ts",
    "core/shells/fold.ts",
    "core/teams/engine.ts",
    "core/work/state.ts",
    "core/work/labels.ts",
    "core/work/due.ts",
    "core/work/fade.ts",
    "core/work/flow.ts",
    "core/work/inbox-tabs.ts",
    "core/work/link.ts",
    "core/job/types.ts",
    "core/job/cron.ts",
    "core/job/tools.ts",
    "core/job/schedule.ts",
    "core/job/run-rows.ts",
    "core/actions/types.ts",
    "core/actions/count.ts",
    "core/actions/view.ts",
    "core/goals/types.ts",
    "core/goals/machine.ts",
    "core/goals/review.ts"
  ]
}