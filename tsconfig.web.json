{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@assets/*": ["./assets/*"]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "web/src",
    "shared",
    "core/work/types.ts",
    "core/cards",
    "core/teams/recipe.ts",
    "core/shells/fold.ts",
    "core/workflows",
    "core/usage/turn-cost.ts",
    "core/teams/engine.ts",
    "core/teams/engine-*.ts",
    "core/work/state.ts",
    "core/work/asks.ts",
    "core/work/fields.ts",
    "core/work/tasks.ts",
    "core/work/verdict.ts",
    "core/work/handoff.ts",
    "core/work/snooze.ts",
    "core/babysit/reviewer.ts",
    "core/babysit/settings.ts",
    "core/babysit/ready.ts",
    "core/babysit/ci.ts",
    "core/babysit/grace.ts",
    "core/babysit/bot-triage.ts",
    "core/babysit/bot-card.ts",
    "core/review/brief.ts",
    "core/work/due.ts",
    "core/work/fade.ts",
    "core/work/flow.ts",
    "core/work/turn.ts",
    "core/work/turn-tabs.ts",
    "core/work/status.ts",
    "core/work/next.ts",
    "core/work/inbox-tabs.ts",
    "core/work/inbox-views.ts",
    "core/work/link.ts",
    "core/work/weights.ts",
    "core/work/corrections.ts",
    "core/work/focus.ts",
    "core/job/types.ts",
    "core/job/filing.ts",
    "core/playbooks/item.ts",
    "core/rules",
    "core/job/cron.ts",
    "core/job/tools.ts",
    "core/job/schedule.ts",
    "core/job/run-rows.ts",
    "core/actions/types.ts",
    "core/actions/own.ts",
    "core/actions/bash.ts",
    "core/actions/sort.ts",
    "core/actions/rules.ts",
    "core/approvals",
    "core/actions/count.ts",
    "core/actions/view.ts",
    "core/junior",
